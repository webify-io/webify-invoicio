# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# ⚠️  Include the database name before `?sslmode`
# Dev  — use a dedicated dev database (suffix with -dev)
DATABASE_URL=postgresql://<user>:<password>@<host>/invoicio-dev?sslmode=require
# Prod (uncomment and swap when deploying) ────────────────────────────────────
# DATABASE_URL=postgresql://<user>:<password>@<host>/invoicio?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dev default — React Vite dev server
CLIENT_URL=http://localhost:5173
# Prod (uncomment and swap when deploying) ────────────────────────────────────
# CLIENT_URL=https://www.yourdomain.co.za

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
